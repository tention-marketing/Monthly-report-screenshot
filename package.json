{
  "name": "tention-monthly-report",
  "version": "0.1.0",
  "private": true,
  "engines": { "node": ">=20" },
  "workspaces": ["apps/*", "packages/*"],
  "scripts": {
    "build": "npm run build --workspace @tention/report-schema && npm run build --workspace @tention/report-core && npm run build --workspace @tention/report-domain && npm run build --workspace @tention/api-client && npm run build --workspace @tention/api && npm run build --workspace @tention/extension",
    "test": "npm run test --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "acceptance": "npm run acceptance --workspace @tention/api",
    "acceptance:synthetic": "npm run acceptance:synthetic --workspace @tention/api",
    "acceptance:extension": "npm run acceptance:extension --workspace @tention/api",
    "acceptance:local": "npm run acceptance:local --workspace @tention/api --",
    "acceptance:import-live": "npm run acceptance:import-live --workspace @tention/api --",
    "klaviyo:inspect-sources": "npm run klaviyo:inspect-sources --workspace @tention/api",
    "review:live-partial": "npm run review:live-partial --workspace @tention/api",
    "klaviyo:test-login": "npm run klaviyo:test-login --workspace @tention/api",
    "dev:api": "npm run dev --workspace @tention/api",
    "dev:extension": "npm run dev --workspace @tention/extension",
    "migrate": "npm run migrate --workspace @tention/api"
  }
}
