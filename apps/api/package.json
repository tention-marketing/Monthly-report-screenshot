{
  "name": "@tention/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "migrate": "tsx src/db/migrate.ts",
    "start": "node dist/server.js",
    "acceptance": "tsx src/reports/acceptance-runner.ts",
    "acceptance:synthetic": "tsx src/reports/acceptance-runner.ts",
    "acceptance:extension": "tsx src/reports/extension-e2e.ts",
    "acceptance:local": "tsx src/reports/local-acceptance-runner.ts",
    "acceptance:import-live": "tsx src/reports/import-live-acceptance.ts",
    "klaviyo:inspect-sources": "tsx src/reports/klaviyo-source-discovery.ts",
    "review:live-partial": "tsx src/reports/dev-partial-review.ts",
    "klaviyo:test-login": "tsx src/reports/klaviyo-test-login.ts",
    "build": "tsc -p tsconfig.json && mkdir -p dist/db/migrations && cp src/db/migrations/*.sql dist/db/migrations/",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config vitest.config.ts",
    "acceptance:subscriber-growth-e2e": "tsx src/reports/subscriber-growth-extension-e2e.ts"
  },
  "dependencies": {
    "@fastify/cors": "^10.0.0",
    "@napi-rs/canvas": "^1.0.10",
    "@tention/report-domain": "0.1.0",
    "@tention/report-schema": "0.1.0",
    "fastify": "^5.12.5",
    "pdfjs-dist": "^6.4.299",
    "pg": "^8.13.0",
    "playwright": "^1.63.0",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/pg": "^8.11.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
